{
  "schema_version": 1,
  "novel_id": "demons",
  "chapter_id": "1_3_5",
  "part": 1,
  "chapter": 3,
  "sentence_count": 86,
  "timeline_start_index": 1730,
  "source_sections": [
    {
      "id": "chapter_01_03_05",
      "source_file": "chapter_01_03_05.txt",
      "sentence_start": 1,
