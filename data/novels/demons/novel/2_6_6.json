{
  "schema_version": 1,
  "novel_id": "demons",
  "chapter_id": "2_6_6",
  "part": 2,
  "chapter": 6,
  "sentence_count": 230,
  "timeline_start_index": 7937,
  "source_sections": [
    {
      "id": "chapter_02_06_06",
      "source_file": "chapter_02_06_06.txt",
