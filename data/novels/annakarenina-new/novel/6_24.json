{
  "schema_version": 1,
  "novel_id": "annakarenina-new",
  "chapter_id": "6_24",
  "part": 6,
  "chapter": 24,
  "sentence_count": 109,
  "timeline_start_index": 16287,
  "source_sections": [
    {
      "id": "chapter_06_24",
      "source_file": "chapter_06_24.txt",
      "sentence_start": 1,
