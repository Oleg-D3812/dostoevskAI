{
  "schema_version": 1,
  "novel_id": "annakarenina-new",
  "chapter_id": "6_3",
  "part": 6,
  "chapter": 3,
  "sentence_count": 114,
  "timeline_start_index": 14042,
  "source_sections": [
    {
      "id": "chapter_06_03",
      "source_file": "chapter_06_03.txt",
      "sentence_start": 1,
