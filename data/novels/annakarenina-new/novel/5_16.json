{
  "schema_version": 1,
  "novel_id": "annakarenina-new",
  "chapter_id": "5_16",
  "part": 5,
  "chapter": 16,
  "sentence_count": 86,
  "timeline_start_index": 12264,
  "source_sections": [
    {
      "id": "chapter_05_16",
      "source_file": "chapter_05_16.txt",
