    {
      "id": "aleksei_vronskii::chapter_02_21_0014",
      "source_section": "chapter_02_21",
      "source_sentence": 90,
      "character_position": 154,
      "text": "Он чувствовал всю мучительность своего и ее положения, всю трудность при той выставленности для глаз всего света, в которой они находились, скрывать свою любовь, лгать и обманывать; и лгать, обманывать, хитрить и постоянно думать о других тогда, когда страсть, связывавшая их, была так сильна, что они оба забывали обо всем другом, кроме своей любви",
      "vad": [
        -0.78,
        0.86,
        -0.58
      ],
      "cluster_id": "aleksei_vronskii-3",
      "distance_to_centroid": 0.4452838388481932,
      "warning": null,
      "chapter_sentence_start": 90,
      "chapter_sentence_end": 90,
      "timeline_start_index": 4862,
      "timeline_end_index": 4862,
      "highlights": [
