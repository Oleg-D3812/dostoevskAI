{
  "schema_version": 1,
  "novel_id": "voskreseniye",
  "chapter_id": "1_48",
  "part": 1,
  "chapter": 48,
  "sentence_count": 110,
  "timeline_start_index": 3172,
  "source_sections": [
    {
      "id": "chapter_01_48",
      "source_file": "chapter_01_48.txt",
      "sentence_start": 1,
