{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "data/catalog.json (unchanged from v1) - the one place for a novel's title/author/year",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "novels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "required": [
              "ru"
            ],
            "additionalProperties": false
          },
          "author": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "required": [
              "ru"
            ],
            "additionalProperties": false
          },
          "year": {
            "type": [
              "integer",
              "string"
            ]
          },
          "description": {
            "type": "object",
            "properties": {
              "ru": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "required": [
              "ru"
            ],
            "additionalProperties": false
          },
          "manifest": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "author",
          "year",
          "manifest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "novels"
  ],
  "additionalProperties": false
}
