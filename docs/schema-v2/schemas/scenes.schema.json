{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenes.schema.json",
  "title": "scenes.json (unchanged from v1) - a bare array",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "chapter": {
        "type": "string",
        "description": "A chapters.json id (e.g. 2_16) - never a source section or the chapter_02_16 form."
      },
      "scene_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "chapter",
      "scene_id",
      "title",
      "summary"
    ],
    "additionalProperties": false
  }
}
