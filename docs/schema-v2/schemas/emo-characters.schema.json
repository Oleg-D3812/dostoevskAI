{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emo-characters.schema.json",
  "title": "emo-characters.json - v1 minus name, label (-> characters_full.json) and the 3 paths (-> manifest.files)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "novel_id": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "fragment_count": {
            "type": "integer"
          },
          "chapter_count": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "color"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "characters"
  ],
  "additionalProperties": false
}
