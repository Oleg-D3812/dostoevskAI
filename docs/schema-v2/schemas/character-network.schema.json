{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-network.schema.json",
  "title": "character-network.json - v1 minus identity fields (label, short_label, desc, intro_chapter) and title",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "generated_at": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "id",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "interaction_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "ru": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "ru"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "degree": {
            "type": "integer"
          },
          "core": {
            "type": [
              "integer",
              "null"
            ]
          },
          "importance": {
            "type": "object",
            "properties": {
              "F": {
                "type": "number"
              },
              "D": {
                "type": "number"
              },
              "W": {
                "type": "number"
              },
              "B": {
                "type": "number"
              },
              "score": {
                "type": "number"
              },
              "tier": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": true
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "interactions": {
            "type": "integer"
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relation": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evolves": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "types": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "raw_weight": {
                  "type": "number"
                },
                "weight": {
                  "type": "number"
                }
              },
              "required": [],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
