{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clusters.schema.json",
  "title": "clusters.json (unchanged from v1)",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "novel_id": {
      "type": "string"
    },
    "vad_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "character_id": {
            "type": "string"
          },
          "local_index": {
            "type": "integer"
          },
          "display_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "centroid": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "size": {
            "type": "integer"
          },
          "within_cluster_spread": {
            "type": "number"
          },
          "sphere_radius": {
            "type": "number"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "id",
          "character_id",
          "name",
          "centroid",
          "size",
          "color"
        ],
        "additionalProperties": true,
        "description": "display_id embeds the character's short name (e.g. 'В.П. Ставрогина-1'); left as the pipeline writes it."
      }
    }
  },
  "required": [
    "schema_version",
    "clusters"
  ],
  "additionalProperties": false
}
